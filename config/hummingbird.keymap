#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF_L 0
#define NAV_L 1
#define NUM_L 2
#define SYM_L 3

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <225>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Spacebar {
            bindings = <&kp SPACE>;
            key-positions = <16 17 18>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <13 12 11>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <10 20>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <8 9>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <19 25>;
        };

        OpenParen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 14>;
        };

        ClosedParan {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <15 5>;
        };

        Period {
            bindings = <&kp PERIOD>;
            key-positions = <16 17>;
        };

        Comma {
            bindings = <&kp COMMA>;
            key-positions = <13 12>;
        };

        Exclamation {
            bindings = <&kp EXCL>;
            key-positions = <17 18>;
        };

        Question {
            bindings = <&kp QUESTION>;
            key-positions = <12 11>;
        };

        ForwardSlash {
            bindings = <&kp SLASH>;
            key-positions = <11 13>;
        };

        Dash {
            bindings = <&kp MINUS>;
            key-positions = <18 16>;
        };

        Apostrophe {
            bindings = <&kp SQT>;
            key-positions = <18 19>;
        };

        Quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W       &kp E        &kp R        &kp T    &kp Y  &kp U        &kp I        &kp O       &kp P
&hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G    &kp H  &hm RSHFT J  &hm RCTRL K  &hm LALT L  &hm RGUI M
            &kp Z       &kp X        &kp C                        &kp V        &kp B        &kp N
                                     &mo 1        &mo 2    &mo 3  &mo 4
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &kp PAGE_UP    &mkp LCLK  &kp UP    &mkp MB2   &trans
&trans  &trans  &trans  &trans  &trans    &kp PAGE_DOWN  &kp LEFT   &kp DOWN  &kp RIGHT  &trans
        &trans  &trans  &trans                           &kp END    &trans    &trans
                        &trans  &trans    &kp ESC        &kp DEL
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &kp MINUS   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp ASTERISK
&trans  &trans  &trans  &trans  &trans    &kp N0      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS
        &trans  &trans  &trans                        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
                        &trans  &trans    &kp PERIOD  &kp SLASH
            >;
        };

        media_layer {
            bindings = <
&trans  &kp PRINTSCREEN  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &kp K_MUTE       &kp K_VOLUME_DOWN     &kp C_VOLUME_UP       &trans    &trans  &trans  &trans  &trans  &trans
        &kp C_REWIND     &kp C_PLAY_PAUSE      &kp C_FAST_FORWARD                      &trans  &trans  &trans
                                               &trans                &trans    &trans  &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&kp PIPE   &kp AT_SIGN     &kp COLON      &kp SEMICOLON  &kp RIGHT_BRACKET    &trans  &trans  &trans  &trans  &trans
&kp GRAVE  &kp UNDERSCORE  &kp CARET      &kp TILDE      &kp LEFT_BRACKET     &trans  &trans  &trans  &trans  &trans
           &kp HASH        &kp AMPERSAND  &kp PLUS                                    &trans  &trans  &trans
                                          &kp LESS_THAN  &kp GREATER_THAN     &trans  &trans
            >;
        };
    };
};
